# Calculadora Fivo — Apache (IONOS Deploy Now usa Apache)
Options -Indexes
DirectoryIndex index.html

# Carpetas internas: nunca públicas
<IfModule mod_alias.c>
  RedirectMatch 404 /(dev|\.git)(/|$)
</IfModule>

# Archivos que nunca deben ser accesibles desde el navegador
<FilesMatch "^(lead-config\.php|README\.md|CLAUDE\.md|\.gitignore)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://pub-3e391b23958e4e1b93d08a1ebeb9c70d.r2.dev https://fivo.ai; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
  <FilesMatch "\.png$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <Files "lead.php">
    Header set Cache-Control "no-store"
  </Files>
</IfModule>
